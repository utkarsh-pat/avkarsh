{
  "name": "avkarsh",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @avkarsh/web dev",
    "build": "pnpm --filter @avkarsh/web build",
    "lint": "pnpm --filter @avkarsh/web lint",
    "typecheck": "pnpm --filter @avkarsh/web typecheck",
    "test": "pnpm --filter @avkarsh/web test",
    "verify:web": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --local --schema public,private,audit --level warning --fail-on error",
    "db:push": "supabase db push"
  },
  "devDependencies": {
    "getdesign": "0.6.24",
    "supabase": "2.110.0"
  }
}
